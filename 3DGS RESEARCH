status.busy":"2026-11-22T22:30:12.680295Z","iopub.execute_input":"2026-11-22T22:30:12.681056Z","iopub.status.idle":"2026-11-22T22:30:13.36662Z","shell.execute_reply.started":"2026-11-22T22:30:12.681026Z","shell.execute_reply":"2026-11-22T22:30:13.365789Z"}},"outputs":[{"name":"stdout","text":"=== svi_frames.py ===\nimport os, sys, json, time, pickle\nimport numpy as np, torch\nfrom PIL import Image\nW = \"/kaggle/working\"; sys.path[:0] = [f\"{W}/svi\", f\"{W}/gs_code\"]\nimport svi_extract as X, svi_gpu as G\nfrom scene.dataset_readers import readColmapSceneInfo\nfrom skimage.metrics import structural_similarity as ssim_fn\nimport lpips\nCAMS = [int(x) for x in os.environ.get(\"SVI_CAMS\", \"0,3,6,9,12,15,18,21\").split(\",\")]\nSTRIDE = int(os.environ.get(\"SVI_STRIDE\", \"4\")); BUDGETS = (0.02, 0.05, 0.10, 0.20, 0.50); NSEED = 3\nOUT = f\"{W}/out8\"; os.makedirs(OUT, exist_ok=True); dev = \"cuda\"\ncfg = open(f\"{W}/out_garden/cfg_args\").read() if os.path.exists(f\"{W}/out_garden/cfg_args\") else \"\"\nBGV = os.environ.get(\"SVI_BG\", \"auto\"); BG = (1.0 if \"white_background=True\" in cfg else 0.0) if BGV == \"auto\" else float(BGV)\nprint(\"background value:\", BG, flush=True)\ntry: si = readColmapSceneInfo(f\"{W}/garden\", \"images_4\", \"\", True, False)\nexcept TypeError: si = readColmapSceneInfo(f\"{W}/garden\", \"images_4\", True)\nmodel = X.load_ply(f\"{W}/out_garden/point_cloud/iteration_7000/point_cloud.ply\", dev)\nlp = lpips.LPIPS(net=\"vgg\").to(dev).eval()\ntorch.set_grad_enabled(False)\npsnr = lambda a, b: float(-10 * np.log10(max(np.mean((a - b) ** 2), 1e-12)))\ntt = lambda im: torch.tensor(im, dtype=torch.float32, device=dev).permute(2, 0, 1)[None]\n\ndef render_T(Z, S, A, C, cr, sr, sg):\n    Cg, Tg = G.alpha_groups(Z, S, A, C, cr)\n    if len(sr):\n        Cx, Tx = G.integrate_groups(Z, S, A, C, cr, sr, sg); Cg[sr, sg] = Cx; Tg[sr, sg] = Tx\n    Tex = G.excl_cumprod(Tg)\n    return (Tex.unsqueeze(-1) * Cg).sum(1) + BG * (Tex[:, -1] * Tg[:, -1])[:, None]\n\ndef sel_random(cr, B, seed):\n    r, g = torch.nonzero(cr[\"elig\"], as_tuple=True); co = cr[\"cost\"][r, g].double()\n    perm = torch.randperm(len(r), generator=torch.Generator().manual_seed(seed)).to(r.device)\n    k = int(torch.searchsorted(torch.cumsum(co[perm], 0), B * co.sum(), right=True)); o = perm[:max(k, 1)]\n    return r[o], g[o]\n\ndef timed(f):\n    torch.cuda.synchronize(); t = time.perf_counter(); o = f(); torch.cuda.synchronize(); return o, (time.perf_counter() - t) * 1e3\n\n\ndef extract_df(model, o, d, a_min=0.01, t_min=1e-4, k_max=300, chunk=32, near=0.1):\n    \"\"\"Depth-first extraction: sort by depth, keep the NEAREST Gaussians until transmittance < t_min (cap k_max nearest).\"\"\"\n    mu, op, sc, Sinv, col = model\n    o_t = torch.tensor(o, dtype=torch.float32, device=dev); D = torch.tensor(d, dtype=torch.float32, device=dev)\n    rel = mu - o_t; SR = torch.einsum(\"nij,nj->ni\", Sinv, rel); C0 = (rel * SR).sum(1)\n    rays, capped = [], 0\n    for i in range(0, len(D), chunk):\n        dd = D[i:i + chunk]\n        A = torch.einsum(\"ri,nij,rj->rn\", dd, Sinv, dd); B = dd @ SR.T\n        z = B / A; s = 1 / torch.sqrt(A)\n        a = torch.clamp(op[None] * torch.exp(-0.5 * (C0[None] - B * B / A)), max=0.99)\n        a = torch.where(z > near, a, torch.zeros_like(a))\n        for r in range(dd.shape[0]):\n            idx = torch.nonzero(a[r] > a_min).squeeze(1)\n            if len(idx) < 1:\n                rays.append((np.array([1.0, 2.0]), np.array([.1, .1]), np.array([.01, .01]), np.zeros((2, 3)))); continue\n            idx = idx[torch.argsort(z[r][idx])]; ar = a[r][idx]\n            Tex = torch.cumprod(torch.cat([ar.new_ones(1), 1 - ar[:-1]]), 0); idx = idx[Tex > t_min]\n            if len(idx) > k_max: idx = idx[:k_max]; capped += 1\n            rays.append(tuple(x.cpu().numpy().astype(np.float64) for x in (z[r][idx], s[r][idx], a[r][idx], col[idx])))\n    print(\"rays capped at k_max (nearest kept):\", capped, \"/\", len(rays), flush=True); return rays\n\nfor k in CAMS:\n    fo = f\"{OUT}/frames_cam{k}_s{STRIDE}.json\"\n    if os.path.exists(fo): print(\"cam\", k, \"cached\"); continue\n    cam = si.test_cameras[k]; img = Image.open(cam.image_path); Wd, Hd = img.size\n    gt = (np.asarray(img.convert(\"RGB\"), dtype=np.float64) / 255)[::STRIDE, ::STRIDE]; h, w = gt.shape[:2]\n    fr = f\"{W}/export8/frame_df_cam{k}_s{STRIDE}.pkl\"\n    if os.path.exists(fr): rays = pickle.load(open(fr, \"rb\"))\n    else:\n        t0 = time.time(); o, d, _ = X.make_rays(cam.R, cam.T, cam.FovX, cam.FovY, Wd, Hd, (0, 0, Wd, Hd))\n        d = d.reshape(Hd, Wd, 3)[::STRIDE, ::STRIDE].reshape(-1, 3)\n        rays = extract_df(model, o, d); pickle.dump(rays, open(fr, \"wb\")); print(f\"cam {k}: extracted {len(rays)} rays in {time.time()-t0:.0f}s\", flush=True)\n    def trunc(r, tmin=1e-6):\n        z, s_, a, c = r; T = np.cumprod(np.concatenate([[1.0], 1 - a[:-1]])); m = T > tmin\n        if m.all(): return r\n        n = max(int(m.sum()), 2); return (z[:n], s_[:n], a[:n], c[:n])\n    nb = sum(len(r[0]) for r in rays); rays = [trunc(r) for r in rays]\n    print(f\"cam {k}: truncated {nb - sum(len(r[0]) for r in rays)} of {nb} Gaussians below T<1e-6\", flush=True)\n    Z, S, A, C = G.pack(rays, dev, torch.float32); cr = G.criterion(Z, S, A, C)\n    print(\"nan in Z,S,A,C:\", [bool(torch.isnan(x).any()) for x in (Z, S, A, C)], \"| nan in criterion score:\", bool(torch.isnan(cr[\"score\"]).any()), flush=True)\n    er, eg = torch.nonzero(cr[\"elig\"], as_tuple=True)\n    ref_img = render_T(Z, S, A, C, cr, er, eg).double().cpu().numpy().reshape(h, w, 3)\n    _, t_all = timed(lambda: render_T(Z, S, A, C, cr, er, eg))\n    e = torch.zeros(0, dtype=torch.long, device=dev)\n    def metrics(imgnp):\n        a = tt(imgnp.clip(0, 1)); b = tt(gt)\n        return dict(psnr_photo=psnr(imgnp, gt), ssim_photo=float(ssim_fn(imgnp, gt, channel_axis=2, data_range=1)),\n                    lpips_vgg_m11=float(lp(a * 2 - 1, b