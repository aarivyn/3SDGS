yfile import PlyData\nSH_C0 = 0.28209479177387814\n\ndef load_ply(path, device):\n    v = PlyData.read(path)[\"vertex\"]\n    g = lambda *n: np.stack([np.asarray(v[k]) for k in n], 1)\n    T = lambda x: torch.tensor(x, dtype=torch.float32, device=device)\n    mu = T(g(\"x\",\"y\",\"z\")); op = torch.sigmoid(T(np.asarray(v[\"opacity\"])))\n    sc = torch.exp(T(g(\"scale_0\",\"scale_1\",\"scale_2\")))\n    q = torch.nn.functional.normalize(T(g(\"rot_0\",\"rot_1\",\"rot_2\",\"rot_3\")), dim=1)\n    col = torch.clamp(0.5 + SH_C0*T(g(\"f_dc_0\",\"f_dc_1\",\"f_dc_2\")), 0, 1)\n    w,x,y,z = q.unbind(1)\n    R = torch.stack([1-2*(y*y+z*z), 2*(x*y-w*z), 2*(x*z+w*y),\n                     2*(x*y+w*z), 1-2*(x*x+z*z), 2*(y*z-w*x),\n                     2*(x*z-w*y), 2*(y*z+w*x), 1-2*(x*x+y*y)], 1).view(-1,3,3)\n    return mu, op, sc, R, col\n\n@torch.no_grad()\ndef extract(model, o, d, a_min=1/255, t_min=0.003, k_max=300, chunk=8, near=0.1, device=\"cuda\"):\n    mu, op, sc, R, col = model\n    o_t = torch.tensor(o, dtype=torch.float32, device=device)\n    D = torch.tensor(d, dtype=torch.float32, device=device)\n    P = -torch.einsum(\"nji,nj->ni\", R, mu - o_t) / sc\n    rays, capped = [], 0\n    for i in range(0, len(D), chunk):\n        dd = D[i:i+chunk]\n        V = torch.einsum(\"nji,rj->rni\", R, dd) / sc[None]\n        A = (V*V).sum(-1)\n        z = -(P[None]*V).sum(-1) / A\n        cr = torch.cross(P[None].expand_as(V), V, dim=-1)\n        d2 = (cr*cr).sum(-1) / A\n        s = 1/torch.sqrt(A)\n        a = torch.clamp(op[None]*torch.exp(-0.5*d2), max=0.99)\n        a = torch.where(z > near, a, torch.zeros_like(a))\n        for r in range(dd.shape[0]):\n            idx = torch.nonzero(a[r] > a_min).squeeze(1)\n            if len(idx) < 2:\n                rays.append((np.array([1.0,2.0]), np.array([.1,.1]), np.array([.01,.01]), np.zeros((2,3)))); continue\n            idx = idx[torch.argsort(z[r][idx])]\n            ar = a[r][idx]\n            Tc = torch.cumprod(torch.cat