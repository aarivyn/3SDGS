o(cr[\"elig\"], as_tuple=True); co = cr[\"cost\"][r, g].double()\n    perm = torch.randperm(len(r), generator=torch.Generator().manual_seed(seed)).to(r.device)\n    k = int(torch.searchsorted(torch.cumsum(co[perm], 0), B * co.sum(), right=True)); o = perm[:max(k, 1)]\n    return r[o], g[o]\n\ndef timed(f):\n    torch.cuda.synchronize(); t = time.perf_counter(); o = f(); torch.cuda.synchronize(); return o, (time.perf_counter() - t) * 1e3\n\nfor k in CAMS:\n    fo = f\"{OUT}/frames_cam{k}_s{STRIDE}.json\"\n    if os.path.exists(fo): print(\"cam\", k, \"cached\"); continue\n    cam = si.test_cameras[k]; img = Image.open(cam.image_path); Wd, Hd = img.size\n    gt = (np.asarray(img.convert(\"RGB\"), dtype=np.float64) / 255)[::STRIDE, ::STRIDE]; h, w = gt.shape[:2]\n    fr = f\"{W}/export8/frame_cam{k}_s{STRIDE}.pkl\"\n    if os.path.exists(fr): rays = pickle.load(open(fr, \"rb\"))\n    else:\n        t0 = time.time(); o, d, _ = X.make_rays(cam.R, cam.T, cam.FovX, cam.FovY, Wd, Hd, (0, 0, Wd, Hd))\n        d = d.reshape(Hd, Wd, 3)[::STRIDE, ::STRIDE].reshape(-1, 3)\n        rays = X.extract(model, o, d); pickle.dump(rays, open(fr, \"wb\")); print(f\"cam {k}: extracted {len(rays)} rays in {time.time()-t0:.0f}s\", flush=True)\n    Z, S, A, C = G.pack(rays, dev, torch.float32); cr = G.criterion(Z, S, A, C)\n    er, eg = torch.nonzero(cr[\"elig\"], as_tuple=True)\n    ref_img = render_T(Z, S, A, C, cr, er, eg).double().cpu().numpy().reshape(h, w, 3)\n    _, t_all = timed(lambda: render_T(Z, S, A, C, cr, er, eg))\n    e = torch.zeros(0, dtype=torch.long, device=dev)\n    def metrics(imgnp):\n        a = tt(imgnp.clip(0, 1)); b = tt(gt)\n        return dict(psnr_photo=psnr(imgnp, gt), ssim_photo=float(ssim_fn(imgnp, gt, channel_axis=2, data_range=1)),\n                    lpips_vgg_m11=float(lp(a * 2 - 1, b * 2 - 1)), lpips_vgg_01=float(lp(a, b)), psnr_vs_correct_all=psnr(imgnp, ref_img))\n    res = dict(cam=k, size_hw=[h, w], stride=STRIDE, bg=BG, n_rays=len(rays), n_eligible=int(cr[\"elig\"].sum()), correct_all_ms=t_all, configs={})\n    im0, t0 = timed(lambda: render_T(Z, S, A, C, cr, e, e)); res[\"configs\"][\"3dgs_alpha\"] = dict(ms=t0, **metrics(im0.double().cpu().numpy().reshape(h, w, 3)))\n    res[\"configs\"][\"correct_all\"] = dict(ms=t_all, **metrics(ref_img))\n    for B in BUDGETS:\n        for name, fsel in ((\"criterion\", lambda: G.select(cr, B)), (\"criterion_density\", lambda: G.select(cr, B, density=True))):\n            (sr, sg), ts = timed(fsel); im, tr = timed(lambda: render_T(Z, S, A, C, cr, sr, sg))\n            res[\"configs\"][f\"{name}_{B}\"] = dict(ms=ts + tr, n_groups=len(sr), **metrics(im.double().cpu().numpy().reshape(h, w, 3)))\n        rr = []\n        for sd in range(NSEED):\n            sr, sg = sel_random(cr, B, sd); im, tr = timed(lambda: render_T(Z, S, A, C, cr, sr, sg)); rr.append(dict(ms=tr, n_groups=len(sr), **metrics(im.double().cpu().numpy().reshape(h, w, 3))))\n        res[\"configs\"][f\"random_{B}\"] = {m: float(np.mean([r[m] for r in rr])) for m in rr[0]}\n        print(f\"cam {k} B={B}: crit {res['configs'][f'criterion_{B}']['psnr_vs_correct_all']:.2f} dB, rand {res['configs'][f'random_{B}']['psnr_vs_correct_all']:.2f} dB vs correct-all\", flush=True)\n    json.dump(res, open(fo, \"w\"), indent=1); del Z, S, A, C, cr; torch.cuda.empty_cache()\nfiles = [json.load(open(f\"{OUT}/frames_cam{k}_s{STRIDE}.json\")) for k in CAMS if os.path.exists(f\"{OUT}/frames_cam{k}_s{STRIDE}.json\")]\nnames = list(files[0][\"configs\"]); ms = (\"psnr_photo\", \"ssim_photo\", \"lpips_vgg_m11\", \"psnr_vs_correct_all\", \"ms\")\nagg = {n: {m: dict(mean=float(np.mean([f[\"configs\"][n][m] for f in files])), std=float(np.std([f[\"configs\"][n][m] for f in files]))) for m in ms} for n in names}\njson.dump(dict(stride=STRIDE, cams=[f[\"cam\"] for f in files], bg=BG, agg=agg, note=\"ray-stage SVI image, DC-colour rays; ms excludes ray extraction; reference = GPU correct-all\"), open(f\"{OUT}/frames_agg_s{STRIDE}.json\"