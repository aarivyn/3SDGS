_proto as P\n\nBUDGETS = (0.02, 0.05, 0.10, 0.20, 0.50)\nGRID = (0, 0.5, 1, 2)\nFIT_B = (0.05, 0.10, 0.20)\n\ndef select(order, cost, B):\n    k = int(np.searchsorted(np.cumsum(cost[order]), B, side=\"right\"))\n    return order[:max(k, 1)]\n\nclass Cam:\n    def __init__(self, rays):\n        self.rays = rays; n = self.n = len(rays)\n        t = time.time(); self.Pr = Pr = [P.prepare_ray(*r) for r in rays]; self.t_prepare = time.time() - t\n        self.elig = [(ri, k) for ri, p in enumerate(Pr) for k, g in enumerate(p[\"groups\"]) if g[\"size\"] > 1]\n        G = len(self.elig); self.G = G\n        self.cost = np.array([Pr[ri][\"groups\"][k][\"exact\"][2] * Pr[ri][\"groups\"][k][\"size\"] for ri, k in self.elig], float)\n        self.base = np.array([P.err(P.compose(p[\"groups\"], set()), p[\"ref\"]) for p in Pr])\n        self.gain = np.array([self.base[ri] - P.err(P.compose(Pr[ri][\"groups\"], {k}), Pr[ri][\"ref\"]) for ri, k in self.elig])\n        segs, gid = [], []\n        for g_i, (ri, k) in enumerate(self.elig):\n            g = Pr[ri][\"groups\"][k]; z, s, a, c = rays[ri]\n            ell, _ = P.segment_scores(z, s, a, c)\n            T = np.cumprod(np.concatenate([[1.0], 1 - a[:-1]]))[:-1]\n            dc = np.linalg.norm(c[:-1] - c[1:], axis=1); op = a[:-1] * a[1:]\n            sl = slice(g[\"i\"], g[\"j\"])\n            segs.append(np.stack([ell[sl], op[sl], dc[sl], T[sl]], 1)); gid += [g_i] * (g[\"j\"] - g[\"i\"])\n        self.seg = np.concatenate(segs); self.gid = np.array(gid)\n        t = time.time()\n        for z, s, a, c in rays:\n            e, _ = P.segment_scores(z, s, a, c); P.make_groups(e)\n        self.t_detect = time.time() - t\n        t = time.time()\n        for ri, k in self.elig:\n            g = Pr[ri][\"groups\"][k]; z, s, a, c = rays[ri]; sl = slice(g[\"i\"], g[\"j\"] + 1)\n            P.integrate(z[sl], s[sl], a[sl], c[sl], (z[sl] - P.TAIL * s[sl]).min(), (z[sl] + P.TAIL * s[sl]).max())\n        self.t_correct_all = time.time()