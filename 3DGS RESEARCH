_args\").read() if os.path.exists(f\"{W}/out_garden/cfg_args\") else \"\"\nBG = 1.0 if \"white_background=True\" in cfg else 0.0\nprint(\"background value:\", BG, flush=True)\ntry: si = readColmapSceneInfo(f\"{W}/garden\", \"images_4\", \"\", True, False)\nexcept TypeError: si = readColmapSceneInfo(f\"{W}/garden\", \"images_4\", True)\ntorch.set_grad_enabled(False)\nSH0 = 0.28209479177387814\n\ndef load_model(path):\n    v = PlyData.read(path)[\"vertex\"]; g = lambda *n: np.stack([np.asarray(v[k]) for k in n], 1)\n    T = lambda a: torch.tensor(a, dtype=torch.float32, device=dev)\n    mu = T(g(\"x\", \"y\", \"z\")); op = torch.sigmoid(T(np.asarray(v[\"opacity\"]))); sc = torch.exp(T(g(\"scale_0\", \"scale_1\", \"scale_2\")))\n    q = torch.nn.functional.normalize(T(g(\"rot_0\", \"rot_1\", \"rot_2\", \"rot_3\")), dim=1)\n    col = torch.clamp(0.5 + SH0 * T(g(\"f_dc_0\", \"f_dc_1\", \"f_dc_2\")), 0, 1)\n    w, x, y, z = q.unbind(1)\n    R = torch.stack([1-2*(y*y+z*z), 2*(x*y-w*z), 2*(x*z+w*y), 2*(x*y+w*z), 1-2*(x*x+z*z), 2*(y*z-w*x), 2*(x*z-w*y), 2*(y*z+w*x), 1-2*(x*x+y*y)], 1).view(-1, 3, 3)\n    return mu, op, sc, R, col\n\ndef extract_stable(model, o, d, a_min=1/255, t_min=0.003, k_max=300, chunk=8, near=0.1):\n    mu, op, sc, R, col = model\n    o_t = torch.tensor(o, dtype=torch.float32, device=dev); D = torch.tensor(d, dtype=torch.float32, device=dev)\n    Pl = -torch.einsum(\"nji,nj->ni\", R, mu - o_t) / sc; rays, capped, t0 = [], 0, time.time()\n    for i in range(0, len(D), chunk):\n        dd = D[i:i + chunk]; V = torch.einsum(\"nji,rj->rni\", R, dd) / sc[None]; A = (V * V).sum(-1); z = -(Pl[None] * V).sum(-1) / A\n        cr = torch.cross(Pl[None].expand_as(V), V, dim=-1); d2 = (cr * cr).sum(-1) / A; s = 1 / torch.sqrt(A)\n        a = torch.clamp(op[None] * torch.exp(-0.5 * d2), max=0.99); a = torch.where(z > near, a, torch.zeros_like(a))\n        for r in range(dd.shape[0]):\n            idx = torch.nonzero(a[r] > a_min).squeeze(1)\n            if len(idx) < 1:\n                rays.append((np.array([1.0, 2.0]), np.array([.1, .1]), np.array([.01, .01]), np.zeros((2, 3)))); continue\n            idx = idx[torch.argsort(z[r][idx])]; ar = a[r][idx]\n            Tc = torch.cumprod(torch.cat([ar.new_ones(1), 1 - ar[:-1]]), 0); idx = idx[Tc > t_min]\n            if len(idx) > k_max: idx = idx[:k_max]; capped += 1\n            rays.append(tuple(x.cpu().numpy().astype(np.float64) for x in (z[r][idx], s[r][idx], a[r][idx], col[idx])))\n        if (i // chunk) % 400 == 0: print(f\"   extract {i}/{len(D)} rays, {time.time()-t0:.0f}s\", flush=True)\n    print(\"rays capped at k_max (nearest kept):\", capped, \"/\", len(rays), flush=True); return rays\n\npsnr = lambda a, b: float(-10 * np.log10(max(np.mean((a - b) ** 2), 1e-12)))\ndef comp_np(r):\n    z, s, a, c = r; T = np.cumprod(np.r_[1.0, 1 - a[:-1]]); return (T[:, None] * a[:, None] * c).sum(0) + BG * np.prod(1 - a)\n\nmodel = load_model(f\"{W}/out_garden/point_cloud/iteration_7000/point_cloud.ply\")\nprint(\"gaussians:\", len(model[0]), flush=True)\n\ndef validate(k=0):\n    pk, gk = f\"{W}/export8/rays_cam{k}_64.pkl\", f\"{W}/export8/gt_cam{k}_64.npy\"\n    if not (os.path.exists(pk) and os.path.exists(gk)): print(\"validate: stored crop missing, skipped\"); return\n    cam = si.test_cameras[k]; Wd, Hd = Image.open(cam.image_path).size; CS = 64\n    o, d, _ = X.make_rays(cam.R, cam.T, cam.FovX, cam.FovY, Wd, Hd, (Wd//2-CS//2, Hd//2-CS//2, CS, CS))\n    sel = np.arange(0, len(d), 8)\n    new = extract_stable(model, o, d[sel]); old = pickle.load(open(pk, \"rb\")); gt = np.load(gk).reshape(-1, 3)[sel]\n    cn = np.array([comp_np(r) for r in new]); co = np.array([comp_np(old[i]) for i in sel])\n    print(f\"VALIDATE cam{k} crop: len new {np.mean([len(r[0]) for r in new]):.1f} vs stored {np.mean([len(old[i][0]) for i in sel]):.1f} | \"\n          f\"PSNR vs photo new {psnr(cn, gt):.2f} stored {psnr(co, gt):.2f} | new vs stored {psnr(cn, co):.2f} dB\", flush=True)\n\ndef render_T